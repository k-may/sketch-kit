{
  "name": "sketch-kit",
  "version": "1.8.0",
  "description": "Rapid prototyping framework for HTML5/Javascript",
  "main": "index.js",
  "bin": {
    "sketch-kit": "index.js"
  },
  "preferGlobal": true,
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "node --test \"test/*.test.mjs\"",
    "clean": "rimraf sketch-kit",
    "test:utils": "node --test test/utils.test.mjs",
    "test:registry": "node --test test/registry.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:setup": "node scripts/smoke.mjs setup",
    "smoke:purge": "node scripts/smoke.mjs purge",
    "test:smoke": "node --test test/smoke.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-may/sketch-kit.git"
  },
  "keywords": [
    "prototyping",
    "HTML5",
    "kit"
  ],
  "author": "k-may (https://github.com/k-may)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/k-may/sketch-kit/issues"
  },
  "homepage": "https://github.com/k-may/sketch-kit",
  "dependencies": {
    "@rollup/plugin-dynamic-import-vars": "^1.4.2",
    "fs-extra": "^10.0.1",
    "inquirer": "^8.2.2",
    "minimist": "latest",
    "replace": "^1.2.1",
    "sass": "^1.50.0",
    "vite": "^7.0.0",
    "vite-plugin-glsl": "^1.3.3",
    "vite-plugin-static-copy": "^3.1.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  }
}
